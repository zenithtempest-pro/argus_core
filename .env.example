# OSINT Credentials
TRUECALLER_INSTALLATION_ID=your_installation_token_here

# Supabase Auth & Database Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Supabase Service Role Key (used exclusively in server-side admin API routes)
# Obtain from Supabase Dashboard -> Project Settings -> API -> service_role secret
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
